# Database
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=rehelp
DB_HOST=127.0.0.1
# In produzione, DATABASE_URL sovrascrive le variabili sopra. Metti DB_SSL=true solo se il DB
# richiede SSL (es. provider managed esterno); per Postgres self-hosted locale lascia false/non impostata.
DB_SSL=false

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
