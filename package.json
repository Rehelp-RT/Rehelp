{
    "name": "rehelp-web",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "node server/app.js",
        "dev": "npm run build & concurrently --kill-others \"npm run serve-api\" \"npm run serve\"",
        "serve": "ng serve --proxy-config proxy.conf.json",
        "build": "ng build --output-path=public",
        "serve-api": "nodemon server/app.js",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "migrate": "sequelize --options-path=server/options.js db:migrate",
        "heroku-postbuild": "ng build --prod --output-path=public && sequelize --options-path=server/options.js db:migrate"
    },
    "engines": {
        "node": "12.9.0",
        "npm": "6.10.3"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "~8.2.3",
        "@angular/cli": "^8.3.19",
        "@angular/common": "~8.2.3",
        "@angular/compiler": "~8.2.3",
        "@angular/compiler-cli": "^8.2.14",
        "@angular/core": "~8.2.3",
        "@angular/forms": "~8.2.3",
        "@angular/platform-browser": "~8.2.3",
        "@angular/platform-browser-dynamic": "~8.2.3",
        "@angular/router": "~8.2.3",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.19.0",
        "bootstrap": "^4.4.1",
        "express": "^4.17.1",
        "font-awesome": "^4.7.0",
        "jquery": "^3.4.1",
        "jsonwebtoken": "^8.5.1",
        "ng-bootstrap": "^1.6.3",
        "passport": "^0.4.1",
        "passport-jwt": "^4.0.0",
        "path": "^0.12.7",
        "pg": "^7.14.0",
        "pg-hstore": "^2.3.3",
        "popper.js": "^1.16.0",
        "rxjs": "~6.4.0",
        "sequelize": "^5.21.2",
        "sequelize-cli": "^5.5.1",
        "tslib": "^1.10.0",
        "typescript": "~3.5.3",
        "zone.js": "~0.9.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~0.803.1",
        "@angular/language-service": "~8.2.3",
        "@types/jasmine": "~3.3.8",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "~8.9.4",
        "codelyzer": "^5.0.0",
        "concurrently": "^5.0.1",
        "enhanced-resolve": "^4.1.1",
        "jasmine-core": "~3.4.0",
        "jasmine-spec-reporter": "~4.2.1",
        "karma": "~4.1.0",
        "karma-chrome-launcher": "~2.2.0",
        "karma-coverage-istanbul-reporter": "~2.0.1",
        "karma-jasmine": "~2.0.1",
        "karma-jasmine-html-reporter": "^1.4.0",
        "nodemon": "^2.0.1",
        "protractor": "~5.4.0",
        "ts-node": "~7.0.0",
        "tslint": "~5.15.0"
    }
}
