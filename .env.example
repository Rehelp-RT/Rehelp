# Database
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=rehelp
DB_HOST=127.0.0.1
# In produzione, DATABASE_URL sovrascrive le variabili sopra. Metti DB_SSL=true solo se il DB
# richiede SSL (es. provider managed esterno); per Postgres self-hosted locale lascia false/non impostata.
DB_SSL=false

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Gmail (password recovery emails)
GMAIL_USER=your_gmail_address_here
GMAIL_PASSWORD=your_gmail_app_password_here

# Auth
JWT_SECRET=your_jwt_secret_here
