{
  "name": "rehelp-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server/app.js",
    "dev": "concurrently --kill-others \"npm run serve-api\" \"npm run serve\"",
    "serve": "ng serve --ssl true --ssl-cert \"ssl/server.crt\" --ssl-key \"ssl/server.key\" --proxy-config proxy.conf.json",
    "build": "ng build --output-path=public",
    "serve-api": "nodemon server/app.js",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "sequelize": "sequelize --options-path=server/options.js",
    "new-migration": "sequelize --options-path=server/options.js migration:create --name",
    "migrate": "npm run sequelize db:migrate",
    "seed": "npm run sequelize db:seed:all",
    "heroku-postbuild": "ng build --prod --output-path=public && npm run migrate"
  },
  "engines": {
    "node": "12.9.0",
    "npm": "6.10.3"
  },
  "private": true,
  "dependencies": {
    "@agm/core": "^1.1.0",
    "@angular/animations": "~9.1.3",
    "@angular/cdk": "^9.2.3",
    "@angular/cli": "^9.1.5",
    "@angular/common": "~9.1.3",
    "@angular/compiler": "~9.1.3",
    "@angular/compiler-cli": "^9.1.3",
    "@angular/core": "~9.1.3",
    "@angular/forms": "~9.1.3",
    "@angular/localize": "^9.1.3",
    "@angular/material": "^9.2.3",
    "@angular/platform-browser": "~9.1.3",
    "@angular/platform-browser-dynamic": "~9.1.3",
    "@angular/router": "~9.1.3",
    "@cloudinary/angular-5.x": "^1.2.2",
    "@fortawesome/angular-fontawesome": "^0.5.0",
    "@fortawesome/fontawesome-svg-core": "^1.2.28",
    "@fortawesome/free-brands-svg-icons": "^5.13.0",
    "@fortawesome/free-regular-svg-icons": "^5.13.0",
    "@fortawesome/free-solid-svg-icons": "^5.13.0",
    "@ng-bootstrap/ng-bootstrap": "^5.3.1",
    "angularx-social-login": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "bluebird": "^3.7.2",
    "body-parser": "^1.19.0",
    "bootstrap": "^4.4.1",
    "cloudinary-core": "^2.8.2",
    "express": "^4.17.1",
    "font-awesome": "^4.7.0",
    "jquery": "^3.5.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.24.0",
    "ng-recaptcha": "^5.0.0",
    "ng2-file-upload": "^1.4.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "path": "^0.12.7",
    "pg": "^7.18.2",
    "pg-hstore": "^2.3.3",
    "popper.js": "^1.16.1",
    "rxjs": "~6.5.5",
    "sequelize": "^5.21.7",
    "sequelize-cli": "^5.5.1",
    "socket.io": "^2.3.0",
    "socket.io-client": "^2.3.0",
    "tslib": "^1.11.1",
    "typescript": "~3.8.3",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.901.5",
    "@angular/language-service": "~9.1.3",
    "@types/googlemaps": "^3.39.3",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "codelyzer": "^5.2.2",
    "concurrently": "^5.2.0",
    "enhanced-resolve": "^4.1.1",
    "jasmine-core": "^3.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "^5.0.4",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.5.3",
    "nodemon": "^2.0.3",
    "protractor": "^6.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~5.15.0"
  }
}
